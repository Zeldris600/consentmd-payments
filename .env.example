PORT=3001
NODE_ENV=DEV

# ── Database ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL — include ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/consentmd_payments?sslmode=require

# ── Redis (Bull queue for async Stripe webhooks) ───────────────────────────────
# Docker Compose sets REDIS_HOST=redis automatically; use localhost when running pnpm locally
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── HTTP ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Laravel IdP ─────────────────────────────────────────────────────────────
LARAVEL_BASE_URL=https://consent-plus-laravel-temp-i4gf7s.laravel.cloud
# RS256 PEM public key — same as consentmd-node-backend JWT verification key
LARAVEL_JWT_PUBLIC_KEY=
LARAVEL_HTTP_TIMEOUT_MS=10000
# Machine-to-machine key for GET /api/internal/organizations/* (from Laravel INTERNAL_API_KEYS)
CONSENTMD_INTERNAL_API_KEY=

# ── Stripe (TEST keys for local dev) ──────────────────────────────────────────
# Secret key: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Webhook signing secret: run `stripe listen --forward-to localhost:3001/api/webhooks/stripe`
# See docs/LOCAL_DEVELOPMENT.md
STRIPE_WEBHOOK_SECRET=
# Optional fallbacks — run scripts/provision-stripe-test-catalog.ts to generate
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ── Inbound service-to-service (this payments service) ────────────────────────
# Key node-backend uses for GET /api/billing/internal/entitlement/:id
INTERNAL_API_KEY=

# ── Billing enforcement ───────────────────────────────────────────────────────
# Days of full access after a failed renewal before org suspension
BILLING_GRACE_PERIOD_DAYS=7
# Seat cap applied locally + sent to IdP when grace expires
BILLING_SUSPENDED_SEAT_LIMIT=1
# Frontend URL for billing portal return links and email CTAs
BILLING_APP_URL=http://localhost:3000

# ── Email (optional — logs to console when unset) ─────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=billing@consentmd.com
