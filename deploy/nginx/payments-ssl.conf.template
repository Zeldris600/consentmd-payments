server {
    listen 443 ssl;
    http2 on;
    server_name payments.consentmd.com;

    ssl_certificate /etc/letsencrypt/live/payments.consentmd.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/payments.consentmd.com/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 2m;

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_pass http://payments_prod;
    }
}

